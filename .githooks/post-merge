#!/usr/bin/env bash
# Auto-deploy hook: runs after git pull / merge.
[ "${SKIP_AUTODEPLOY:-0}" = "1" ] && exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

if git rev-parse --verify -q ORIG_HEAD >/dev/null 2>&1; then
  changed="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null || true)"
  echo "$changed" | grep -qE '^(app\.py|requirements\.txt|Dockerfile|docker-compose\.yml|\.dockerignore|observability/|scripts/)' || exit 0
  echo "[auto-deploy] deploy-relevant changes merged — starting pipeline in background"
  echo "[auto-deploy] log: .pipeline/deploy-*.log"
  nohup scripts/deploy.sh >/dev/null 2>&1 &
fi

# ------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored.
# ------------------------------------------------------------------

# Supabase (server-side). Use the service_role key for the backend:
# it stays on the server and is never shipped to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key

# Grafana admin login (local + tunnel)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Basic auth in front of the public Alertmanager UI
ALERTMANAGER_AUTH_USER=admin
ALERTMANAGER_AUTH_HASH=$2a$14$replace-with-bcrypt-hash

# Generate with:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-password'

# JWT signing secret for access tokens (generate: openssl rand -hex 32)
JWT_SECRET=change-me

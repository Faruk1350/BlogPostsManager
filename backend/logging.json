{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    },
    "access": {
      "format": "%(asctime)s INFO uvicorn.access %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    },
    "app_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "default",
      "filename": "/var/log/blog/app.log",
      "maxBytes": 10485760,
      "backupCount": 3
    },
    "access_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "access",
      "filename": "/var/log/blog/access.log",
      "maxBytes": 10485760,
      "backupCount": 3
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["console", "app_file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["console", "app_file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console", "access_file"],
      "level": "INFO",
      "propagate": false
    },
    "blog": {
      "handlers": ["console", "app_file"],
      "level": "INFO",
      "propagate": false
    },
    "blog.database": {
      "handlers": ["console", "app_file"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["console"],
    "level": "INFO"
  }
}
